# Copy to `.secret.local` (git-ignored via `*.local`) so the Functions
# emulator can resolve `defineSecret(...)`. Never commit real values.
#
# For deploys, set the same names with:
#   npx -y firebase-tools@latest functions:secrets:set KITAQSIGN_API_KEY
#
# The outer Basic gate and the registrar id are shared by both registries, so
# there is one entry each; only the API key is issued per registry. The values
# come from spec test 0 (registrar A). Registrar B is operated from Swagger,
# not from this app, so it has no entry here.

BASIC_GATE_USER=
BASIC_GATE_PASSWORD=
REGISTRAR_ID=

KITAQSIGN_API_KEY=
KITAQNIC_API_KEY=

# Optional: point the BRIDGE layer at a local stub instead of the real
# registries. Leave unset to use https://epp.kitaqsign.com / kitaqnic.com.
# KITAQSIGN_BASE_URL=http://127.0.0.1:8899
# KITAQNIC_BASE_URL=http://127.0.0.1:8898
