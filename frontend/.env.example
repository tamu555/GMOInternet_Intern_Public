# Copy to .env.local and adjust as needed. All values below are the defaults.
#
# Vite's root is this directory, so only files here are loaded - and only keys
# prefixed with VITE_ ever reach the client bundle.
#
# WARNING: `vite build` reads .env.local too. A stale VITE_FIREBASE_EMULATOR=true
# left in .env.local produces a production bundle that talks to 127.0.0.1.

# --- Firebase (Local Emulator Suite; see docs/firebase/README.md) ---
# Project id the emulator runs under (demo- prefix = fully offline).
VITE_FIREBASE_PROJECT_ID=demo-teamc-2026
# Connect the SDK to the local emulators (default: true in dev).
VITE_FIREBASE_EMULATOR=true
# Host where the emulators listen.
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
# Auth / Functions emulator ports (must match firebase.json).
VITE_AUTH_EMULATOR_PORT=9099
VITE_FUNCTIONS_EMULATOR_PORT=5001

# --- Firebase web app config (deployed projects only) ---
# From the Firebase console: Project settings > General > Your apps > SDK setup.
# The emulator ignores all three, so they stay empty for local work; only a
# build that points at the real project needs them filled in.
# Auth API key (falls back to the emulator's dummy "demo-api-key").
VITE_FIREBASE_API_KEY=
# Auth domain (falls back to "<project-id>.firebaseapp.com").
VITE_FIREBASE_AUTH_DOMAIN=
# Web app id ("1:...:web:..."). Required by Analytics; unused by Auth/Functions.
VITE_FIREBASE_APP_ID=

# --- Analytics (GA4) ---
# Measurement id ("G-XXXXXXXXXX"). This is the ONLY switch for Analytics:
# empty or unset means GA4 never initializes, which is the default for local
# and CI runs. When it is set, collection starts on page load with no consent
# banner and no opt-in gate (see src/firebase/analytics.ts). Emulator sessions
# stay excluded regardless, so a real id here is still inert until
# VITE_FIREBASE_EMULATOR=false.
VITE_FIREBASE_MEASUREMENT_ID=

# --- Provisional REST layer (auth/signup only; retired after auth migration) ---
# Serve auth/signup from MSW mocks (default: true in dev).
VITE_ENABLE_MOCKS=true

# --- Misc ---
# Polling cadence for the order result screen, in milliseconds.
VITE_ORDER_POLL_INTERVAL_MS=1500
