/playwright-report/
/test-results/
/.playwright-cli/

# Local Miniflare state written by `wrangler pages dev dist`, the way to
# exercise functions/ and public/_headers (the Cloudflare Pages deployment)
# without deploying. Regenerated on every run.
/.wrangler/
